{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runs.schema.json",
  "title": "Runs",
  "description": "The two runs of the same day and the order of their beats. A beat is a station id (s01..s07), a station variant (\"s01:night\"), or \"end\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["1", "2"],
  "properties": {
    "$schema": { "type": "string" },
    "1": { "$ref": "#/$defs/run" },
    "2": { "$ref": "#/$defs/run" }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "beats", "evidence"],
      "properties": {
        "title": { "type": "string", "description": "\"Run 1 · Today\" / \"Run 2 · With the hub\"." },
        "subtitle": { "type": "string" },
        "target_seconds": { "type": "integer", "description": "Spec: Run 1 about 60 s; whole game about 5 minutes." },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(s0[1-7](:[a-z]+)?|end)$" }
        },
        "proposed": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
