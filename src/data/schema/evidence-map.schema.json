{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-map.schema.json",
  "title": "Evidence map",
  "description": "Every source the game may cite. Ids: F## our photos, D-p## deck pages, X## open-licence photos, M## map data, C-* cited reports, SPEC-* our own proposal (always shown as Proposed), E### research checkpoint entries (once research/evidence.csv is in the repo).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "sources": {
      "type": "object",
      "propertyNames": { "pattern": "^(F\\d{2}|D-p\\d{1,2}|X\\d{2}|M\\d{2}|C-[a-z0-9-]+|SPEC-[a-z0-9-]+|E\\d{3})$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["field-photo", "deck", "external-photo", "map", "report", "proposal", "research"] },
          "title": { "type": "string" },
          "file": { "type": "string", "description": "Repo-relative path." },
          "url": { "type": "string" },
          "deck_page": { "type": "integer" },
          "licence": { "type": "string", "description": "Required for external-photo and map." },
          "credit": { "type": "string", "description": "Required for external-photo and map; shown on the credits screen." },
          "supports": { "type": "string", "description": "The claim this source backs, in a few words." },
          "proposed": { "type": "boolean", "description": "true for our own proposal; the UI marks it Proposed." }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "enum": ["external-photo", "map"] } } }, "then": { "required": ["licence", "credit"] } },
          { "if": { "properties": { "kind": { "const": "proposal" } } }, "then": { "required": ["proposed"] } }
        ]
      }
    }
  }
}
