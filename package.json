  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "terser": "5.39.0",
    "typescript": "5.7.3",
    "vite": "6.3.5"
  }
}
